# sdl pkg-config source file

prefix=/opt/devkitpro/portlibs/gamecube
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: sdl
Description: Simple DirectMedia Layer is a cross-platform multimedia library designed to provide low level access to audio, keyboard, mouse, joystick, 3D hardware via OpenGL, and 2D video framebuffer.
Version: 1.2.15
Requires:
Conflicts:
Libs: -L${libdir}  -mogc -mcpu=750 -meabi -mhard-float                   -L/opt/devkitpro/portlibs/gamecube/lib                   -L/opt/devkitpro/portlibs/ppc/lib -lSDLmain -lSDL                    -L/opt/devkitpro/libogc/lib/cube -laesnd -lfat -logc -lm
Libs.private: -mogc -mcpu=750 -meabi -mhard-float                   -L/opt/devkitpro/portlibs/gamecube/lib                   -L/opt/devkitpro/portlibs/ppc/lib -lSDLmain -lSDL                    -L/opt/devkitpro/libogc/lib/cube -laesnd -lfat -logc -lm  -lm
Cflags: -I${includedir}/SDL -D_GNU_SOURCE=1 -mogc -mcpu=750 -meabi -mhard-float                      -Wall -O2                      -I/opt/devkitpro/libogc/include -DGEKKO                      -I/opt/devkitpro/portlibs/gamecube/include                      -I/opt/devkitpro/portlibs/ppc/include
