includedir=/opt/devkitpro/portlibs/ppc/include

Name: lz4
Description: extremely fast lossless compression algorithm library
URL: http://www.lz4.org/
Version: 1.9.3
Libs: -L/opt/devkitpro/portlibs/ppc/lib -llz4
Cflags: -I/opt/devkitpro/portlibs/ppc/include
