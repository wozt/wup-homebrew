prefix=/opt/devkitpro/portlibs/ppc
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: gd
Description: GD graphics library
Version: 2.3.3
Requires:
Requires.private:   zlib  libpng  freetype2 >= 9.8.3  libjpeg
Cflags: -I${includedir}
Libs.private:  @LIBICONV@
Libs: -L${libdir} -lgd
