prefix=/opt/devkitpro/portlibs/ppc
exec_prefix=/opt/devkitpro/portlibs/ppc
libdir=/opt/devkitpro/portlibs/ppc/lib
includedir=/opt/devkitpro/portlibs/ppc/include

Name: harfbuzz
Description: HarfBuzz text shaping library
Version: 8.2.0

Libs: -L${libdir} -lharfbuzz
Libs.private: -lm      
Requires.private:  freetype2 >= 12.0.6 
Cflags: -I${includedir}/harfbuzz
