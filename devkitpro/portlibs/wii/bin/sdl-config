#!/bin/sh

prefix=/opt/devkitpro/portlibs/wii
exec_prefix=${prefix}
exec_prefix_set=no
libdir=${exec_prefix}/lib

#usage="\
#Usage: sdl-config [--prefix[=DIR]] [--exec-prefix[=DIR]] [--version] [--cflags] [--libs]"
usage="\
Usage: sdl-config [--prefix[=DIR]] [--exec-prefix[=DIR]] [--version] [--cflags] [--libs] [--static-libs]"

if test $# -eq 0; then
      echo "${usage}" 1>&2
      exit 1
fi

while test $# -gt 0; do
  case "$1" in
  -*=*) optarg=`echo "$1" | LC_ALL="C" sed 's/[-_a-zA-Z0-9]*=//'` ;;
  *) optarg= ;;
  esac

  case $1 in
    --prefix=*)
      prefix=$optarg
      if test $exec_prefix_set = no ; then
        exec_prefix=$optarg
      fi
      ;;
    --prefix)
      echo $prefix
      ;;
    --exec-prefix=*)
      exec_prefix=$optarg
      exec_prefix_set=yes
      ;;
    --exec-prefix)
      echo $exec_prefix
      ;;
    --version)
      echo 1.2.15
      ;;
    --cflags)
      echo -I${prefix}/include/SDL -D_GNU_SOURCE=1 -mrvl -mcpu=750 -meabi -mhard-float                      -Wall -O2                      -I/opt/devkitpro/libogc/include -DGEKKO                      -I/opt/devkitpro/portlibs/wii/include                      -I/opt/devkitpro/portlibs/ppc/include
      ;;
#    --libs)
#      echo -L${exec_prefix}/lib  -mrvl -mcpu=750 -meabi -mhard-float                   -L/opt/devkitpro/portlibs/wii/lib                   -L/opt/devkitpro/portlibs/ppc/lib -lSDLmain -lSDL                     -L/opt/devkitpro/libogc/lib/wii -laesnd -lwiiuse -lbte -lwiikeyboard -lfat -logc -lm
#      ;;
#    --static-libs)
    --libs|--static-libs)
      echo -L${exec_prefix}/lib  -mrvl -mcpu=750 -meabi -mhard-float                   -L/opt/devkitpro/portlibs/wii/lib                   -L/opt/devkitpro/portlibs/ppc/lib -lSDLmain -lSDL                     -L/opt/devkitpro/libogc/lib/wii -laesnd -lwiiuse -lbte -lwiikeyboard -lfat -logc -lm  -lm
      ;;
    *)
      echo "${usage}" 1>&2
      exit 1
      ;;
  esac
  shift
done
